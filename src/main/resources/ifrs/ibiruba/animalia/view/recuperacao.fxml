<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ifrs.ibiruba.animalia.controller.RecuperacaoController"
      alignment="CENTER"
      spacing="0"
      styleClass="root"
      stylesheets="@../css/animalia.css">

    <VBox alignment="CENTER" spacing="4" VBox.vgrow="ALWAYS">
        <padding><Insets top="30" right="60" bottom="20" left="60"/></padding>

        <Label text="Recuperar senha" styleClass="titulo"/>
        <Label text="Informe o código recebido no cadastro"
               style="-fx-text-fill:#6c757d; -fx-font-size:12px;"/>

        <VBox spacing="10" style="-fx-background-color:white; -fx-padding:28; -fx-border-radius:8; -fx-background-radius:8;"
              maxWidth="340">
            <padding><Insets top="12"/></padding>

            <Label text="E-mail" style="-fx-font-weight:bold;"/>
            <TextField fx:id="emailField" promptText="seu@email.com"/>

            <Label text="Código de recuperação" style="-fx-font-weight:bold;"/>
            <TextField fx:id="codigoField" promptText="8 caracteres"/>

            <Label text="Nova senha" style="-fx-font-weight:bold;"/>
            <PasswordField fx:id="novaSenhaField" promptText="Mínimo 8 caracteres"/>

            <Label text="Confirmar nova senha" style="-fx-font-weight:bold;"/>
            <PasswordField fx:id="confirmarNovaSenhaField" promptText="Repita a nova senha"/>

            <Label fx:id="mensagemLabel" styleClass="mensagem-erro" wrapText="true"/>

            <Button fx:id="redefinirButton" text="Redefinir senha" onAction="#redefinir"
                    styleClass="btn-primary" maxWidth="Infinity"/>

            <HBox alignment="CENTER">
                <Hyperlink fx:id="voltarLoginLink" text="Voltar ao login" onAction="#voltarLogin"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
